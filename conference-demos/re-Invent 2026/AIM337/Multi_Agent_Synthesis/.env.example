# Copy to .env to override defaults. All values are optional: defaults live in
# src/evidence_synthesis/config.py, and real environment variables take
# precedence over this file. The .env file is read from the working directory.

AWS_REGION=us-east-1

# Per-role Bedrock model routing. Verify current inference profile IDs in your
# target region before deployment (aws bedrock list-inference-profiles).
#EVIDENCE_EXTRACTOR_MODEL_ID=us.amazon.nova-lite-v1:0
#ANALYST_MODEL_ID=us.anthropic.claude-sonnet-5
#VERIFIER_MODEL_ID=us.anthropic.claude-sonnet-5
#SYNTHESIZER_MODEL_ID=us.anthropic.claude-sonnet-5
#SINGLE_AGENT_MODEL_ID=us.anthropic.claude-sonnet-5

# Per-role, per-invocation output token caps.
#EVIDENCE_EXTRACTOR_MAX_TOKENS=4096
#ANALYST_MAX_TOKENS=10000
#VERIFIER_MAX_TOKENS=15000
#SYNTHESIZER_MAX_TOKENS=10000
#SINGLE_AGENT_MAX_TOKENS=15000

# Optional standalone Bedrock Guardrail. Enabled only when both are set.
# Use a numbered version in production.
#BEDROCK_GUARDRAIL_ID=
#BEDROCK_GUARDRAIL_VERSION=

# Optional deployed storage boundaries.
#SOURCE_BUCKET=
#SOURCE_PREFIX=sources
#ARTIFACT_BUCKET=
#ARTIFACT_PREFIX=runs

# Optional local Streamlit overrides. Blank values are discovered from SSM.
#EVIDENCE_SYNTHESIS_REGION=us-east-1
#EVIDENCE_SYNTHESIS_RUNTIME_ARN=
#EVIDENCE_SYNTHESIS_ENDPOINT_NAME=
#EVIDENCE_SYNTHESIS_INPUT_BUCKET=
#EVIDENCE_SYNTHESIS_INVOKER_ROLE_ARN=

# Pipeline orchestration limits (cumulative across all stages).
#PIPELINE_DEADLINE_SECONDS=300
#PIPELINE_TOKEN_BUDGET=200000
#PIPELINE_MAX_RETRIES=1
#PIPELINE_MAX_VERIFICATION_CYCLES=2
